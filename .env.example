# Base URL of the Meta model provider API.
ARIA_HOME_PROVIDER_URL=
# Identifier of the Meta model to call at runtime.
ARIA_HOME_MODEL_ID=
# API key for the model provider, local environment only.
MODEL_API_KEY=
# Set to 1 to enable live model calls, anything else keeps synthetic mode.
ARIA_HOME_MODEL_ENABLED=
# Test-only hooks for the Playwright e2e suite (POST /api/investigations
# test_delay_s, test_fail, lease_s). Default off: leave unset or empty.
# Only the Playwright web-server configs set ARIA_HOME_E2E_HOOKS=1; never
# set it in normal runs.
ARIA_HOME_E2E_HOOKS=
# Maximum output tokens for a single investigation model call (integer 256-32000, default 12000).
ARIA_HOME_INVESTIGATION_MAX_TOKENS=
# API key for Baseten (evaluation only), local environment only.
BASETEN_API_KEY=
# Baseten model to call in evaluation only (default meta-models/muse-spark-open-1026).
ARIA_HOME_BASETEN_MODEL_ID=
# Set to 1 to enable the Baseten evaluation provider, anything else refuses it.
ARIA_HOME_BASETEN_ENABLED=
# WhatsApp test delivery (optional, off by default): real delivery happens
# only when all four are set. WHATSAPP_TEST_RECIPIENT is the owner's own
# verified test number, which stands in for the HVAC company; no other
# recipient is ever sent to. Local environment only, never committed.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_RECIPIENT=
ARIA_HOME_WHATSAPP_LIVE=
# Emporia Vue read-only live panel (optional, off by default): live watts
# are fetched only when all three are set, and are display only, never
# evidence. Local environment only, never committed.
EMPORIA_EMAIL=
EMPORIA_PASSWORD=
ARIA_HOME_EMPORIA_LIVE=
# Visual evidence is replay-only: the app never constructs the SamLiveProvider
# adapter, so setting ARIA_HOME_VISUAL_LIVE=1 changes nothing. Placeholder only.
ARIA_HOME_VISUAL_LIVE=
# Deploy-time version stamp reported by /api/health (a 7-40 character hex commit; anything else is ignored).
ARIA_HOME_RELEASE_COMMIT=
# Optional owner-only Nest camera snapshot (off by default). Credentials from a
# Google Device Access project; run backend/scripts/nest_auth.py once to obtain
# NEST_REFRESH_TOKEN. NEST_DEVICE_NAME is needed only with several cameras.
# Public-demo mode refuses to start with ARIA_HOME_NEST_LIVE set.
NEST_PROJECT_ID=
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=
NEST_REFRESH_TOKEN=
NEST_DEVICE_NAME=
ARIA_HOME_NEST_LIVE=
