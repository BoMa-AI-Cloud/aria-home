{"model_laws": [{"check": "check_no_heat_from_watts", "id": "no-heat-from-watts", "origin": "design", "statement": "Electrical activity alone is never heat.", "status": "active"}, {"check": "check_ack_not_resolution", "id": "ack-is-not-resolution", "origin": "design", "statement": "Acknowledgement is not resolution.", "status": "active"}, {"check": "check_reconnect_proves_nothing", "id": "reconnect-proves-nothing", "origin": "design", "statement": "Thermostat reconnection alone proves nothing.", "status": "active"}, {"check": "check_human_report_not_measurement", "id": "human-report-is-not-measurement", "origin": "design", "statement": "A human report never counts as a sensor measurement.", "status": "active"}, {"check": "check_no_detection_not_safe", "id": "no-detection-is-not-safe", "origin": "design", "statement": "No detection never means safe.", "status": "active"}, {"check": "check_stale_not_current", "id": "stale-is-not-current", "origin": "design", "statement": "An old or superseded reading is never current.", "status": "active"}, {"check": "check_conflicts_block_success", "id": "conflicts-block-success", "origin": "design", "statement": "Unresolved contradictory readings block success.", "status": "active"}, {"check": "check_no_images_or_personal_in_hvac", "id": "no-images-or-personal-in-hvac", "origin": "design", "statement": "Images and personal details never enter HVAC payloads.", "status": "active"}, {"check": "check_weather_never_decides", "id": "weather-never-decides", "origin": "design", "statement": "Weather forecast context never decides readiness on its own.", "status": "proposed"}], "process_laws": [{"check": "backend/tests/test_process_laws.py::test_audit_rows_name_existing_tests", "id": "process-audit-rows-name-tests", "stage": "Fixing a problem", "statement": "Every fix in the project's audit logs names at least one regression test, and that test exists."}, {"check": "backend/tests/test_process_laws.py::test_audit4_rows_have_red_proofs", "id": "process-audit4-rows-have-red-proofs", "stage": "Proving a fix", "statement": "Every fix in the latest audit log has a recorded proof that its test fails without the fix."}, {"check": "backend/tests/test_process_laws.py::test_build_log_tasks_have_prompts", "id": "process-build-log-tasks-have-prompts", "stage": "Building a task", "statement": "Every task in the build log has its prompt on file, and every prompt on file is listed."}, {"check": "backend/tests/test_process_laws.py::test_env_example_has_no_live_values", "id": "process-env-example-placeholders-only", "stage": "Before a release", "statement": "The example settings file holds placeholders only, with every live setting off."}, {"check": "backend/tests/test_process_laws.py::test_ci_enables_no_live_flags", "id": "process-ci-never-enables-live", "stage": "Automated tests", "statement": "Automated tests never turn on live model calls, message delivery, energy-meter data or live image checks."}, {"check": "backend/tests/test_process_laws.py::test_health_reports_version", "id": "process-health-reports-version", "stage": "After a restart", "statement": "The health check reports which version is running."}, {"check": "checked at review", "id": "process-release-needs-approval", "stage": "Release and deployment", "statement": "A release is pushed only with the project owner's approval, and a deployment needs approval of the specific host and step."}], "version": "laws-v1"}