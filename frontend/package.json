{
  "name": "aria-home-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:alt-ports": "playwright test -c playwright.alt.config.ts --project=utc -g \"synthetic evidence overview\"",
    "test:e2e:public-demo": "playwright test -c playwright.public-demo.config.ts",
    "record:demo": "playwright test -c playwright.record.config.ts --project=chrome && playwright test -c playwright.record.config.ts --project=insets && playwright test -c playwright.record.config.ts --project=keys",
    "record:insets": "playwright test -c playwright.record.config.ts --project=insets",
    "record:keys": "playwright test -c playwright.record.config.ts --project=keys",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
